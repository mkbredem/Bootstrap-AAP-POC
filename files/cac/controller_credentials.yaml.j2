---
controller_credentials:
  - name: "AAP Credential"
    description: !unsafe 'AAP credential for applying configuration as code'
    credential_type: "Red Hat Ansible Automation Platform"
    organization: "Ansible Product Demos (APD)"
    inputs:
      host: "https://host.containers.internal"
      password: "{{ aap_password }}"
      username: "{{ aap_user }}"
      verify_ssl: false
  - name: "APD Machine Credential"
    description: !unsafe 'Machine credential placeholder - update with SSH key or password for managed hosts'
    credential_type: "Machine"
    organization: "Ansible Product Demos (APD)"
    inputs:
      username: "{{ apd_machine_user | default('ec2-user') }}"
      password: "{{ apd_machine_password | default('') }}"
  - name: "AWS Secret"
    description: !unsafe 'AWS credential for EC2 dynamic inventory'
    credential_type: "Amazon Web Services"
    organization: "Ansible Product Demos (APD)"
    inputs:
      username: "{{ aws_access_key | default('') }}"
      password: "{{ aws_secret_key | default('') }}"
